# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# --- Required: Carbonized / carbon marketplace (public chain variables) ---
# These are the only variables needed to deploy. Everything marked Optional
# can be left out; the site then runs without accounts and comments.
# Network (NEXT_PUBLIC_NETWORK):
#   robinhood-mainnet  Robinhood Chain MAINNET (chain id 4663, canonical USDG with 6 decimals)
#   robinhood          Robinhood Chain testnet (chain id 46630, test tokens, no value)
#   hardhat | sepolia | amoy | polygon  other EVM targets
# Any value other than robinhood-mainnet shows a "Testnet / unaudited" banner.
#
# MAINNET (set all of these; contract addresses come from the mainnet deployment):
#   NEXT_PUBLIC_NETWORK=robinhood-mainnet
#   NEXT_PUBLIC_CHAIN_ID=4663
#   NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com   (or a keyed provider)
#   NEXT_PUBLIC_LOGS_RPC_URL=https://robinhood-rpc.publicnode.com (default for 4663)
#   NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com (default for 4663)
#   NEXT_PUBLIC_USDG_ADDRESS=<canonical USDG on Robinhood Chain; the app reads its decimals()>
# TESTNET:
#   NEXT_PUBLIC_NETWORK=robinhood
#   NEXT_PUBLIC_CHAIN_ID=46630
#   NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
NEXT_PUBLIC_NETWORK=robinhood
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CARBON_CREDIT_NFT=0x
NEXT_PUBLIC_CARBON_CREDIT_TOKEN=0x
NEXT_PUBLIC_CARBON_CREDIT_TOKEN_GOLD_STANDARD=0x
NEXT_PUBLIC_CARBON_CREDIT_TOKEN_ICM_COMPLIANCE=0x
NEXT_PUBLIC_CARBON_MARKETPLACE=0x
NEXT_PUBLIC_CARBON_PRICE_ORACLE=0x
NEXT_PUBLIC_EMISSION_VERIFIER=0x
# Production uses USDG. Testnet rehearsal may use the deployed Test USDC mock;
# keep the legacy fallback only when a testnet mock cannot be renamed honestly.
NEXT_PUBLIC_USDG_ADDRESS=0x
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_CARBON_REGISTRY=0x
# Optional: CARB utility stack (token, staking, issuer bond, governance). Leave unset until CARB is launched:
# the token and governance pages then show "CARB is not live yet" and nothing else depends on them.
# CARB token contract. Leave unset until the official CARB contract is launched;
# the landing page then shows "CARB contract address: Coming soon".
NEXT_PUBLIC_CARB_TOKEN=
# External (launchpad) CARB only: "true" when CARB is not Carbonized's own CarbToken (shows the External token info line).
NEXT_PUBLIC_CARB_EXTERNAL=
# External CARB without votes of its own: the CarbVotes wrapper (vCARB). Governance then needs CARB deposited in it.
NEXT_PUBLIC_CARB_VOTES=
NEXT_PUBLIC_CARB_STAKING=
NEXT_PUBLIC_ISSUER_BOND=
NEXT_PUBLIC_GOVERNOR=
NEXT_PUBLIC_TIMELOCK=
# First block to scan for on-chain events (deployment block of the contracts)
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Optional off-chain depository backend. LEAVE EMPTY unless you run one: when set, company
# registration details (including email/phone) are POSTed to this URL from the visitor's browser.
NEXT_PUBLIC_BACKEND_URL=
# Reown (WalletConnect) project id from https://dashboard.reown.com - leave empty to use injected wallets only
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Optional: site & analytics ---
# Site URL (optional): defaults to the Vercel-provided domain, or localhost.
NEXT_PUBLIC_APP_URL=""
# Public contact address shown on the contact page (replace the placeholder before launch).
NEXT_PUBLIC_CONTACT_EMAIL=""
# Block explorer override (defaults: mainnet https://robinhoodchain.blockscout.com, testnet https://explorer.testnet.chain.robinhood.com).
NEXT_PUBLIC_EXPLORER_URL=""

# Analytics (optional), using Umami
# @see https://umami.is
NEXT_PUBLIC_UMAMI_URL="" # URL of your Umami instance
NEXT_PUBLIC_UMAMI_WEBSITE_ID="" # Website ID of your Umami instance

# --- Optional: accounts & comments ---
# Sign-in and blog comments turn on only when ALL of these are set.
DATABASE_URL="postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/blog"
# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
BETTER_AUTH_URL=""
BETTER_AUTH_SECRET=""
# @see https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: Sumsub KYC/KYB (server-only; requires all auth/database values above) ---
# Never use NEXT_PUBLIC_ variables and never commit real values.
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""
SUMSUB_WEBHOOK_SECRET=""
SUMSUB_KYC_LEVEL=""

# Optional: RPC used only for wide-range eth_getLogs scans (history, audit, certificates).
# Needed when NEXT_PUBLIC_RPC_URL is a plan that caps getLogs ranges (e.g. Alchemy free tier = 10 blocks).
# Defaults to the official Robinhood mainnet RPC for mainnet log scans.
# Override only with a provider that supports historical `eth_getLogs`.
NEXT_PUBLIC_LOGS_RPC_URL=
