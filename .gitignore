# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
.pnpm-store/
.pnpm-debug.log*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated content
.source
next-env.d.ts

# next-sitemap
/public/robots.txt
/public/sitemap*.xml

# local build output, logs and operator material - never public
/.open-next/
/.wrangler/
/contracts/*.txt
/contracts/*.log
/contracts/deployments/
/contracts/scripts/deploy/live/
/contracts/scripts/deploy/create_controlled_manifest.js
/contracts/release/*.md
/build-ignore-workspace.txt
/competitor-citations.json
/.cspellcache
/homepage.html
/dev-server.log
/opennext-build*.log
/handoff/

/*.txt
__pycache__/
/wallet-page.html
/wrangler-deploy*.log

# secrets and operator material - never commit
*.pem
*.key
*.keystore
*.p12
.secrets/
/contracts/deployments/*.partial.json
/contracts/release/*.json
!/contracts/release/mainnet-release-manifest.example.json
*.private.*
