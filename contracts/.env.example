# Carbonized contracts workspace: copy to `.env` (gitignored) and fill in. NEVER commit real values.
#
# INTERNAL REVIEW ONLY: these contracts have not had a professional audit. Do not put real value behind
# them before one (see DEPLOY.md).

# --- Deployer key (hex, with or without 0x) ---------------------------------------------------
# Use a dedicated, freshly generated key per network that holds only gas funds. On mainnet the script
# hands every role to ADMIN_MULTISIG and the deployer renounces everything, so this key is worthless afterwards.
PRIVATE_KEY=

# --- RPC endpoints -----------------------------------------------------------------------------
# Robinhood Chain testnet (chain id 46630)
ROBINHOOD_RPC=https://rpc.testnet.chain.robinhood.com/rpc
# Robinhood Chain MAINNET (chain id 4663). Fallback: https://robinhood-rpc.publicnode.com
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# --- Block explorer verification (Blockscout needs no key; any non-empty value works) ---------
# Mainnet explorer: https://robinhoodchain.blockscout.com
BLOCKSCOUT_API_KEY=blockscout

# =================================================================================================
# MAINNET DEPLOYMENT (scripts/deploy/20_deploy_mainnet.js, --network robinhoodMainnet)
# =================================================================================================
# Required. The script asserts chain id 4663, USDG decimals() == 6 and symbol() == USDG,
# that the multisigs have code, and prints a dry-run summary. Nothing is sent unless CONFIRM_MAINNET=yes.
MAINNET_USDG=
# Contract address of the multisig (e.g. a Safe) that ends up holding DEFAULT_ADMIN_ROLE, FEE_MANAGER_ROLE
# and every other role. It must have code; an EOA is rejected. The deployer renounces everything.
ADMIN_MULTISIG=
# Contract address that receives the WHOLE fixed CARB supply (may equal ADMIN_MULTISIG). Required unless
# DEPLOY_TOKEN=no or CARB_TOKEN_ADDRESS is set (not used with an external token). It must have code and must
# not be the deployer.
TREASURY_MULTISIG=
# "no" = deploy the protocol only; deploy the CARB stack later with scripts/deploy/21_deploy_token_mainnet.js
DEPLOY_TOKEN=yes

# --- Oracle (Chainlink Functions is NOT assumed to exist on chain 4663: verify it first, see DEPLOY.md) ---
# Default (empty / anything but "yes"): the three consumers are deployed UNCONFIGURED and
# CarbonPriceOracle.reportPrice (ORACLE_REPORTER_ROLE) is the only price source.
ENABLE_ORACLE=
# Required ONLY with ENABLE_ORACLE=yes:
FUNCTIONS_ROUTER=
DON_ID=
SUBSCRIPTION_ID=
# Optional with ENABLE_ORACLE=yes: https URL templates for setPriceSources (comma separated, max 5)
PRICE_SOURCE_URLS=
FUNCTIONS_GAS_LIMIT=300000
# Optional: addresses that get ORACLE_REPORTER_ROLE (the manual reportPrice fallback). Never the deployer.
ORACLE_REPORTERS=

# Optional: comma separated addresses that get ISSUER_ROLE on the NFT (the only way credits are minted).
ISSUER_ADDRESS=
# Optional: "yes" (needs ENABLE_ORACLE=yes) also gives ISSUER_ROLE to the EmissionVerifier. Default: off.
ENABLE_ORACLE_ISSUANCE=
# Optional launch parameters (defaults shown)
TRADING_FEE_BPS=25
MIN_PRICE_PER_TONNE_USD=1
# KYC gate for AMM / auctions: mainnet default ON ("off" disables); testnet default OFF.
KYC_GATE=on
EXPECTED_USDG_SYMBOL=USDG

# --- CARB stack (all values are bound-checked by the script AND on-chain; empty = default shown) --------
# External token (launched through a third-party launchpad): address of the existing ERC-20. CarbToken is NOT
# deployed then. Needs decimals 0..24, NO fee-on-transfer, NO rebasing; burn() and ERC-5805 votes are optional.
# Accepted by 10_/20_/21_ (20_ with DEPLOY_TOKEN=no is refused). Check first, read-only (no key):
#   CARB_TOKEN_ADDRESS=0x... npx hardhat run scripts/deploy/22_attach_token_check.js --network robinhoodMainnet
# The token's owner, mint authority, tax, blacklist, LP lock and upgradeability are outside Carbonized's control.
CARB_TOKEN_ADDRESS=
# REQUIRED to broadcast with CARB_TOKEN_ADDRESS: the token's exact symbol, case sensitive (the address if the
# symbol is empty). Set it on the command line with CONFIRM_MAINNET=yes; a dry run needs neither.
# CONFIRM_TOKEN=
# Voting token of the governor with an external token: auto (default: native if the token is ERC-5805 with a
# timestamp clock, else a CarbVotes wrapper), native, or wrapper.
CARB_VOTES_MODE=auto
# Governance stage at deployment: "dual" (timelock gets PARAMETER/SLASHER roles, multisig keeps its copies)
# or "bootstrap" (timelock holds nothing). The multisig always keeps DEFAULT_ADMIN on every contract.
GOVERNANCE_STAGE=dual
# Timelock: delay in seconds (script floor 172800 = 2 days, contract max 30 days). Extra proposers (besides the
# governor) and executors ("open" = anyone, "governor", or a comma separated list).
TIMELOCK_MIN_DELAY=172800
TIMELOCK_PROPOSERS=
TIMELOCK_EXECUTORS=open
# Governor (seconds / whole CARB / percent): delay 1h..7d, period 1d..14d, threshold 1..50,000,000 whole tokens,
# quorum 1..20 (with a wrapper, quorum is a share of the WRAPPED supply)
GOV_VOTING_DELAY=86400
GOV_VOTING_PERIOD=432000
GOV_PROPOSAL_THRESHOLD_CARB=1000000
GOV_QUORUM_PERCENT=4
# Staking: warmup 1h..14d, cooldown 1d..30d (immutable), 3 increasing thresholds (1..50,000,000 WHOLE tokens,
# scaled by the token's decimals; fractions only up to `decimals` digits; not above the token's total supply),
# 4 non-decreasing discounts in bps (first 0, max 5000)
STAKING_WARMUP=259200
STAKING_COOLDOWN=604800
STAKING_THRESHOLDS_CARB=1000,5000,25000
STAKING_DISCOUNTS_BPS=0,1000,2500,5000
# Issuer bond: min bond 1..100,000,000 whole tokens, unbond delay 7d..90d, dispute window 1d..30d. The bond path
# stays CLOSED (off) at launch: while open, anyone who pays the bond can mint credits. Slashed tokens go to
# BOND_SLASH_TREASURY if set; otherwise they are burned only if the token has a working burn(uint256), else sent
# to the slash sink (default 0x...dEaD, changeable later with setSlashSink).
BOND_MIN_CARB=10000
BOND_UNBOND_DELAY=2592000
BOND_DISPUTE_WINDOW=604800
BOND_REQUIRED=off
BOND_SLASH_TREASURY=

# Set to "yes" ONLY for the real broadcast, on the command line, not in this file:
#   RELEASE_MANIFEST=/secure/path/release-manifest.json CONFIRM_MAINNET=yes npm run deploy:mainnet
# The manifest is required for a real chain-4663 broadcast and must have two approvals plus the final audit SHA-256.
# See release/mainnet-release-manifest.example.json and DEPLOY.md; it is intentionally not supplied by this template.
# RELEASE_MANIFEST=
# CONFIRM_MAINNET=

# =================================================================================================
# TESTNET (scripts/deploy/10_deploy_all.js, --network robinhood). Mock USDC (6 decimals) + mock router.
# =================================================================================================
# Optional: extra wallets that receive 1,000,000 test USDC
USDC_MINT_TO=
# KYC_GATE also applies here, but the testnet default is OFF (set KYC_GATE=on to test the gate).
# Optional (defaults are placeholders; the mock router ignores them). The testnet script always configures the
# oracle (reference sources + TEST-ONLY https://example.invalid price sources), makes the deployer the CARB
# treasury and ORACLE_REPORTER, and reads the same GOV_* / STAKING_* / BOND_* / TIMELOCK_* variables as above
# (testnet: BOND_REQUIRED defaults to on).
# DON_ID=
# SUBSCRIPTION_ID=

# --- Web app (written by scripts/update-carb-env.js) -----------------------------------------
# Override the .env.local that `npm run update:carb` / `update:carb:mainnet` writes into.
# CARBON_ENV_FILE=
