{
  "name": "carbonized-contracts",
  "version": "1.0.0",
  "description": "Solidity contracts for the Carbonized carbon credit marketplace",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit/*.test.js",
    "test:integration": "hardhat test test/integration/*.test.js",
    "test:fuzzing": "hardhat test test/fuzzing/*.fuzz.js",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:nft": "hardhat test test/unit/CarbonCreditNFT.test.js",
    "test:token": "hardhat test test/unit/CarbonCreditToken.test.js",
    "test:marketplace": "hardhat test test/unit/CarbonMarketplace.test.js",
    "test:oracle": "hardhat test test/unit/EmissionVerifier.test.js",
    "test:registry": "hardhat test test/unit/RegistrySync.test.js",
    "test:price": "hardhat test test/unit/CarbonPriceOracle.test.js",
    "deploy:local": "hardhat run scripts/deploy/01_deploy_local.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy/03_deploy_sepolia.js --network sepolia",
    "deploy:mumbai": "hardhat run scripts/deploy/02_deploy_mumbai.js --network mumbai",
    "deploy:polygon": "hardhat run scripts/deploy/03_deploy_polygon.js --network polygon",
    "update:sepolia": "node scripts/update-frontend-sepolia.js",
    "verify:sepolia": "node scripts/verify/verify_sepolia.js",
    "verify:mumbai": "hardhat run scripts/verify/verify_mumbai.js --network mumbai",
    "verify:polygon": "hardhat run scripts/verify/verify_polygon.js --network polygon",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "lint:js": "eslint '**/*.js'",
    "lint:js:fix": "eslint '**/*.js' --fix",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.js' 'scripts/**/*.js'",
    "format:check": "prettier --check 'contracts/**/*.sol' 'test/**/*.js' 'scripts/**/*.js'",
    "analyze": "slither .",
    "analyze:detailed": "slither . --print human-summary",
    "size": "hardhat size-contracts",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "backend:test": "cd backend && npm test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "postinstall": "npm run compile",
    "update:carb": "node scripts/update-carb-env.js --network robinhood",
    "deploy:robinhood": "hardhat run scripts/deploy/10_deploy_all.js --network robinhood",
    "deploy:mainnet": "hardhat run scripts/deploy/20_deploy_mainnet.js --network robinhoodMainnet",
    "deploy:token:mainnet": "hardhat run scripts/deploy/21_deploy_token_mainnet.js --network robinhoodMainnet",
    "check:token": "hardhat run scripts/deploy/22_attach_token_check.js --network robinhoodMainnet",
    "verify:robinhood": "hardhat run scripts/verify/verify_deployment.js --network robinhood",
    "verify:mainnet": "hardhat run scripts/verify/verify_deployment.js --network robinhoodMainnet",
    "update:carb:mainnet": "node scripts/update-carb-env.js --network robinhoodMainnet",
    "test:deploy": "hardhat test test/integration/DeployScripts.test.js",
    "check:payment-token": "node scripts/verify/check_payment_token.js"
  },
  "keywords": [
    "carbon-credits",
    "blockchain",
    "chainlink",
    "defi",
    "climate",
    "esg",
    "web3",
    "polygon",
    "oracle",
    "sustainability"
  ],
  "author": "Carbonized Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarbonizedLab/carbonized"
  },
  "bugs": {
    "url": "https://github.com/CarbonizedLab/carbonized/issues"
  },
  "homepage": "https://carbonized.app",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^4.9.3",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "@chainlink/functions-toolkit": "^0.2.6",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "chai": "^4.3.10",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.1.1",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  }
}
